{
  "type": "object",
  "properties": {
    "kanji": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "description": {
            "type": "string",
            "allOf": [
              {
                "minLength": 1,
                "description": "Japanese note for recall: meaning, nuance, common contexts, or a short mnemonic."
              }
            ]
          },
          "readings": {
            "type": "array",
            "items": {
              "type": "string",
